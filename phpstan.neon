parameters:
	level: 8
	paths:
		- src
		- tests
	excludePaths:
	    - tests/Matecat/benchmark.php
	ignoreErrors:
		# Redundant $f100 !== 11 and $n100 != 11 in CardinalDecimalRule are kept on purpose to
		# mirror the CLDR rule text (see the comment there). Only some PHPStan versions flag them
		# ($f100 !== 11: 2.2.5 does, 2.2.15 does not; $n100 != 11: 2.3.6 does), and composer.lock
		# is not committed, so the ignores must not fail when unmatched.
		-
			identifier: notIdentical.alwaysTrue
			path: src/ICU/Plurals/Rules/CardinalDecimalRule.php
			reportUnmatched: false
		-
			identifier: notEqual.alwaysTrue
			path: src/ICU/Plurals/Rules/CardinalDecimalRule.php
			reportUnmatched: false
